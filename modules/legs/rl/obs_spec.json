  "normalizer": {
    "formula": "(obs - mean) / std",
    "mean_key": "norm__mean__state",
    "std_key": "norm__std__state",
    "note": "Brax running-statistics std already includes std_eps. Eval applies it to the clean policy observation."
  },
  "network": {
    "hidden": [
      512,
      256,
      128
    ],
    "activation": "swish",
    "distribution": "tanh_normal",
    "deterministic_action": "tanh of the first 30 outputs of the last linear layer (loc). The last layer is 60 wide: loc then scale.",
    "weight_keys": "pi__params__hidden_{i}__kernel and pi__params__hidden_{i}__bias for i=0..3. Kernel layout is (in, out)."
  },
  "action": {
    "range": [
      -1.0,
      1.0
    ],
    "meaning": "residual added to the PD position target, in radians, after multiplying by action_scale",
    "target": "clip(base + payload_frac * carry_offset + action * action_scale, joint lower, joint upper)",
    "base": "home_q when abs(cmd_vx)<0.12 and abs(cmd_vy)<0.12 and abs(cmd_yaw)<0.2, else the phase-indexed blend of the 0.8, 1.0 and 1.2 reference cycles",
    "phase_period_s": 1.0,
    "phase_zero": "left toe-off of the r7 reference cycle",
    "payload_frac": "payload mass / 20, 0 on the walk gates and 1 on the 20 kg carry gate"
  },
  "pd": {
    "formula": "tau = clip(kp * kp_scale * (q_target - q) - kd * kp_scale * qd, -tmax, tmax)",
    "tmax": "tau_lim * strength * derate",
    "derate": "clip(1 - abs(qd) / (1.2 * w_lim), 0, 1) when w_lim > 0, else 1. Upper body w_lim is 0 so it is not derated.",
    "kp_kd_randomization": "one shared kp_scale ~ Uniform(0.85, 1.15) multiplies both kp and kd at reset",
    "strength": "Uniform(0.85, 1.10) at reset. Eval uses 1.",
    "latency": "0 to 10 physics steps (0 to 20 ms). Substeps before the delay use the previous target. Eval uses 0.",
    "kp_rule": "clip(tau_lim / 0.25, 80, 2800). kd = 2*sqrt(kp*max(armature, 0.05)) + 0.015*kp. action_scale = min(0.25, tau_lim/kp), which is 0.25 for every actuator."
  },
